{
  "description": "Caps Lock (F19): tap F19, hold IJKL for arrows",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "f19",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "to": [
        {
          "set_variable": {
            "name": "caps_f19_navigation",
            "value": 1
          }
        }
      ],
      "to_after_key_up": [
        {
          "set_variable": {
            "name": "caps_f19_navigation",
            "value": 0
          }
        }
      ],
      "to_if_alone": [
        {
          "key_code": "f19"
        }
      ],
      "parameters": {
        "basic.to_if_alone_timeout_milliseconds": 1000
      }
    },
    {
      "type": "basic",
      "from": {
        "key_code": "i",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "to": [
        {
          "key_code": "up_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "caps_f19_navigation",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "j",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "to": [
        {
          "key_code": "left_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "caps_f19_navigation",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "k",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "to": [
        {
          "key_code": "down_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "caps_f19_navigation",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "l",
        "modifiers": {
          "optional": [
            "any"
          ]
        }
      },
      "to": [
        {
          "key_code": "right_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "caps_f19_navigation",
          "value": 1
        }
      ]
    }
  ]
}
